<body>
  <div id="header"></div>
  <div id="mobile-menu"></div>
  <div id="hero"></div>
  <div id="about-me"></div>
  <div id="what"></div>
  <div id="portfolio"></div>
  <div id="reviews"></div>
  <div id="footer"></div>
  <div id="modal"></div>

  <script type="module">
    // Load partials dynamically
    const loadPartials = async () => {
      const sections = [
        { id: "header", url: "./partials/home/header-sec.html" },
        { id: "mobile-menu", url: "./partials/home/mobile-menu.html" },
        { id: "hero", url: "./partials/home/hero-sec.html" },
        { id: "about-me", url: "./partials/home/about_me-sec.html" },
        { id: "what", url: "./partials/home/what-sec.html" },
        { id: "portfolio", url: "./partials/home/portfolio-sec.html" },
        { id: "reviews", url: "./partials/home/reviews-sec.html" },
        { id: "footer", url: "./partials/home/footer-sec.html" },
        { id: "modal", url: "./partials/home/modal.html" },
      ];

      for (const section of sections) {
        const response = await fetch(section.url);
        const content = await response.text();
        document.getElementById(section.id).innerHTML = content;
      }
    };

    loadPartials();
  </script>
  <script type="module" src="./js/home/header.js"></script>
  <script type="module" src="./js/home/mobile-menu.js"></script>
  <script type="module" src="./js/home/accordion.js"></script>
  <script type="module" src="./js/home/about-me.js"></script>
